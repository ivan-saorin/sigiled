# SIGILED control-plane env — copy next to docker-compose.yml as `.env`.
# NEVER commit the filled file. Values marked (required) fail the boot
# loudly when missing; everything else has a sane default.

# --- instance identity (required) -------------------------------------------
DOMAIN=example.com                  # public base domain: api.$DOMAIN, auth.$DOMAIN
GITHUB_OWNER=your-github-user       # the account/org that owns project repos

# --- GitHub (required for POST /projects) -----------------------------------
GITHUB_PAT=                         # classic PAT, repo scope: create-from-template,
                                    # deploy keys. Absent = POST /projects answers 503.
VM_TMPL_REPO=vm-tmpl                # template repo name under GITHUB_OWNER

# --- auth: the two legs (design §1) -----------------------------------------
SIGILED_OIDC_BASE=https://auth.example.com   # IdP base; absent = OIDC leg off
SIGILED_BOOTSTRAP_BEARER=           # legacy bootstrap-admin bearer; set it for
                                    # first boot, retire it after the IdP works
SIGILED_DEVICE_CLIENT_ID=sigiled-device      # device-flow provider client_id
SIGILED_ADMIN_GROUP=stack:admins
SIGILED_DRIVER_GROUP=stack:drivers
AUTHENTIK_API_TOKEN=                # optional, admin API token: lets
                                    # GET /skill/{driver} embed real client_secrets

# --- workspace runtime ------------------------------------------------------
SIGILED_RUNTIME=docker              # unset = branch-only dev mode, no containers
SIGILED_NETWORK=mgr-net             # external docker network shared with the edge
SIGILED_VM_IMAGE=ghcr.io/ivan-saorin/vm-base:0.1.0   # public base image (DEC-20)
DOCKER_GID=988                      # `getent group docker | cut -d: -f3` on YOUR box

# --- misc -------------------------------------------------------------------
SIGILED_STATE_DIR=/data             # inside the container; volume-backed
SIGILED_TEMPLATE_LATEST=            # latest template version, e.g. 0.1.0 (optional)
SEARXNG_BASE_URL=                   # optional; rendered into driver skills
TZ=UTC                              # jobs cron fires in this timezone

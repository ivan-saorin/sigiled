# SIGILED edge — the two routes the contract (§1) requires, as the
# reference instance runs them in Caddy. Any edge works if it honors the
# same two contracts: forward /sigiled/* verbatim, and swap the session
# token into Authorization on /s/. {$DOMAIN} comes from the edge's env.

api.{$DOMAIN} {
	# SIGILED control plane, forwarded VERBATIM (no strip, no edge gate):
	# sigiledd is its own auth authority (bootstrap bearer or OIDC JWT);
	# an edge-level bearer gate here would lock JWT drivers out.
	handle /sigiled/* {
		reverse_proxy sigiled:8080
	}

	# Session workspaces (contract §1): one static rule, dynamic upstream
	# via docker DNS on the shared network. /s/{project}/rest →
	# vm-{project}:8000/rest; the placeholder resolves per-request, so a
	# new session never needs an edge reload. X-Session-Token is swapped
	# into Authorization and the workspace agent validates it — the
	# per-project token IS the auth; whatever Authorization the client
	# sent is not inspected at this edge.
	@session path_regexp s ^/s/([a-z][a-z0-9-]*)(/.*)$
	handle @session {
		route {
			rewrite * {re.s.2}
			request_header Authorization "Bearer {http.request.header.X-Session-Token}"
			reverse_proxy vm-{re.s.1}:8000
		}
	}
}

auth.{$DOMAIN} {
	# The IdP (authentik in the reference instance). No gate: authentik IS
	# the auth layer, its login UI must be publicly reachable for the
	# device flow (elevate) to work.
	reverse_proxy authentik-server:9000
}
# ── The service method (DEC-27): one vhost, bearer split ──────────────
# A stack service that is dual by nature (human UI + machine API on the
# same upstream) keeps ONE name; how the client knocks decides the leg.
# A request presenting `Authorization: Bearer` is the machine leg —
# stack bearer checked, spoofable identity headers scrubbed; anything
# else is the human leg — authentik forward_auth, identity copied. A
# machine with a wrong key gets a clean 401, never an HTML login page.
(dual) {
	@machine header_regexp Authorization ^Bearer\s
	handle @machine {
		@bad_bearer not header Authorization "Bearer {$API_BEARER_KEY}"
		respond @bad_bearer 401
		reverse_proxy {args[0]} {
			header_up -X-Authentik-Username
			header_up -X-Authentik-Groups
			header_up -X-Authentik-Email
		}
	}
	handle {
		route {
			reverse_proxy /outpost.goauthentik.io/* authentik-server:9000
			forward_auth authentik-server:9000 {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
				@err status 401
				handle_response @err {
					redir https://{http.request.host}/outpost.goauthentik.io/start?rd={http.request.uri}
				}
			}
			reverse_proxy {args[0]}
		}
	}
}
# Usage — a dual service is two lines; machine-only services keep the
# plain bearer gate + reverse_proxy:
#
#	search.{$DOMAIN} {
#		import dual searxng:8080
#	}

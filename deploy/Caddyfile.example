# SIGILED edge — the two routes the contract (§1) requires, as the
# reference instance runs them in Caddy. Any edge works if it honors the
# same two contracts: forward /sigiled/* verbatim, and swap the session
# token into Authorization on /s/. {$DOMAIN} comes from the edge's env.

api.{$DOMAIN} {
	# SIGILED control plane, forwarded VERBATIM (no strip, no edge gate):
	# sigiledd is its own auth authority (bootstrap bearer or OIDC JWT);
	# an edge-level bearer gate here would lock JWT drivers out.
	handle /sigiled/* {
		reverse_proxy sigiled:8080
	}

	# Session workspaces (contract §1): one static rule, dynamic upstream
	# via docker DNS on the shared network. /s/{project}/rest →
	# vm-{project}:8000/rest; the placeholder resolves per-request, so a
	# new session never needs an edge reload. X-Session-Token is swapped
	# into Authorization and the workspace agent validates it — the
	# per-project token IS the auth; whatever Authorization the client
	# sent is not inspected at this edge.
	@session path_regexp s ^/s/([a-z][a-z0-9-]*)(/.*)$
	handle @session {
		route {
			rewrite * {re.s.2}
			request_header Authorization "Bearer {http.request.header.X-Session-Token}"
			reverse_proxy vm-{re.s.1}:8000
		}
	}
}

auth.{$DOMAIN} {
	# The IdP (authentik in the reference instance). No gate: authentik IS
	# the auth layer, its login UI must be publicly reachable for the
	# device flow (elevate) to work.
	reverse_proxy authentik-server:9000
}
# ── The service method (DEC-27): one vhost, bearer split ──────────────
# A stack service that is dual by nature (human UI + machine API on the
# same upstream) keeps ONE name; how the client knocks decides the leg.
# A request presenting `Authorization: Bearer` is the machine leg —
# stack bearer checked, spoofable identity headers scrubbed; anything
# else is the human leg — authentik forward_auth, identity copied. A
# machine with a wrong key gets a clean 401, never an HTML login page.
#
# The machine leg accepts TWO credentials during the migration to
# identity-bearing tokens:
#
#   1. the static {$API_BEARER_KEY} — what the stack has always done. One
#      shared secret per callee, no idea who presented it, rotation means
#      editing env on every caller at once.
#   2. an IdP-signed JWT, adjudicated by sigiledd at /sigiled/auth/verify.
#      By default (SIGILED_SERVICE_POLICY=any-authenticated) the rule is
#      simply: a token this stack's IdP signed, unexpired, from the trusted
#      issuer. Same trust boundary as the shared bearer it replaces — minus
#      the shared secret, plus a caller name in the logs, plus revocation by
#      disabling a client and rotation by an hour passing.
#      docs/per-service-authorization.md documents the optional tightening
#      to per-callee grants; it is an env var, not an edge change.
#
# Both are accepted deliberately: flipping straight to (2) would break every
# caller on the stack in the same instant, including the deployed apps that
# have the static token in their env today. Drop the static arm — the
# `@not_stack_bearer` matcher, making the forward_auth unconditional — once
# nothing presents it any more.
#
# Static wins first on purpose: it costs no round trip, so the migration
# never makes the hot path slower for callers that have not moved yet.
#
# The callee name sigiledd is told about comes from the HOSTNAME, not from
# a snippet argument: labels are right-indexed, so on a two-label {$DOMAIN}
# index 2 is the first label — genie.example.com → "genie". Site names ARE
# catalog names on the reference instance, which makes this free. Learned
# the hard way (2026-08-15, live edge): passing it as {args[1]} produced
# "Placeholder {args[N]} index is out of bounds" warnings on the deployed
# caddy, and an empty header. Hostname derivation has no such failure mode
# and keeps every call site a plain one-argument `import dual`.
#
# The equivalent machine-only gate, for services with no human leg — call
# sites stay a bare `import bearer`:
#
#	(bearer) {
#		@not_stack_bearer not header Authorization "Bearer {$API_BEARER_KEY}"
#		forward_auth @not_stack_bearer sigiled:8080 {
#			uri /sigiled/auth/verify
#			header_up X-Sigiled-Service {http.request.host.labels.2}
#			copy_headers X-Sigiled-Caller
#		}
#	}
#	genie.{$DOMAIN} {
#		import bearer
#		reverse_proxy genie:8000
#	}
#
(dual) {
	@machine header_regexp Authorization ^Bearer\s
	handle @machine {
		# The two-credential gate, inline (same shape as (bearer) above):
		# the static key skips the round trip entirely; anything else is
		# adjudicated by sigiledd — 2xx allow, else the 401/403/500 is
		# returned to the caller as-is.
		# X-Sigiled-Service is set HERE, never read from the client: a
		# caller that sends its own is overwritten, which is what makes
		# the header trustworthy on the sigiledd side. Under the default
		# policy sigiledd ignores the value; sending it anyway is what
		# makes a later flip to per-service one env var, no edge edit.
		@not_stack_bearer not header Authorization "Bearer {$API_BEARER_KEY}"
		forward_auth @not_stack_bearer sigiled:8080 {
			uri /sigiled/auth/verify
			header_up X-Sigiled-Service {http.request.host.labels.2}
			copy_headers X-Sigiled-Caller
		}
		reverse_proxy {args[0]} {
			header_up -X-Authentik-Username
			header_up -X-Authentik-Groups
			header_up -X-Authentik-Email
		}
	}
	handle {
		route {
			reverse_proxy /outpost.goauthentik.io/* authentik-server:9000
			forward_auth authentik-server:9000 {
				uri /outpost.goauthentik.io/auth/caddy
				copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
				@err status 401
				handle_response @err {
					redir https://{http.request.host}/outpost.goauthentik.io/start?rd={http.request.uri}
				}
			}
			reverse_proxy {args[0]}
		}
	}
}
# Usage — a dual service is two lines; machine-only services use the
# (bearer) snippet documented above:
#
#	search.{$DOMAIN} {
#		import dual searxng:8080
#	}
#
# ── Applying this to a live edge ──────────────────────────────────────
# This pattern went to the reference instance's edge on 2026-08-15 and was
# verified end-to-end the same evening (driver JWT reads genie/adhd
# openapi.json and search JSON through the gate; static callers unchanged).
# Three operational lessons from that deploy, all cheap to inherit:
#
#   1. VALIDATE BEFORE RELOAD, in the container's own image:
#	docker run --rm --env-file .env -v $PWD/Caddyfile:/tmp/C:ro \
#	  caddy:<your tag> caddy validate --adapter caddyfile --config /tmp/C
#   2. A SINGLE-FILE bind mount pins the inode: an editor that saves via
#      temp-file-and-rename (micro, vim, most of them) silently detaches
#      the running container from your edits — every reload re-reads the
#      OLD bytes and the error line numbers never move. Bind the DIRECTORY
#      instead, or write strictly via `cat new > Caddyfile` redirection.
#   3. Count what loaded: the "automatic TLS certificate management" log
#      line lists every domain the config actually carries. If the count
#      is short, the config was truncated in transit — caddy adapts what
#      it was given and will not complain about sites that simply aren't
#      there.
#
# The reload is safe by construction: every caller presenting today's static
# token keeps working (arm 1), and the new arm can only ever ADD an accepted
# credential. To check it before trusting it, from a host with the stack
# bearer:
#
#	curl -sS -o /dev/null -w '%{http_code}\n' \
#	  -H "Authorization: Bearer $STACK_BEARER" https://search.{$DOMAIN}/
#	# 200 — the static arm still answers
#
#	curl -sS -H "Authorization: Bearer <a driver JWT>" \
#	  -H 'X-Sigiled-Service: search' https://api.{$DOMAIN}/sigiled/auth/verify
#	# 200 + {"caller":"sigiled-claude","service":"search",
#	#        "granted_by":"authenticated"} — the new arm is live.
#	# Under the per-service policy the same call answers 403 with
#	# {"detail":"caller sigiled-claude lacks svc:search"} until the group
#	# is provisioned.
#
#	curl -sS -o /dev/null -w '%{http_code}\n' \
#	  -H 'Authorization: Bearer not-a-token' https://search.{$DOMAIN}/
#	# 401 — a bad credential is still refused, which is the check that
#	# actually matters after widening what counts as a good one.

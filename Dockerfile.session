# Session image of the sigiled repo itself (DEC-25): the workspace that
# develops sigiledd needs cargo + cc on top of the deliberately minimal
# base. Pinned to the same toolchain the root Dockerfile builds vm-base
# with — a session must be able to reproduce the release build.
# System-wide rustup (the pattern of the official rust images): the agent
# runs as uid 1000, so CARGO_HOME must be writable for the registry cache.
# RUSTUP_HOME stays root-owned and read-only, which is why every component
# this repo's quality gate needs must be baked in HERE: a session cannot add
# one later (`rustup component add` → permission denied, and relocating the
# rustup home is a 593 MB copy). Until 2026-08-15 the profile was `minimal`
# with nothing added, so `cargo fmt` and `cargo clippy` did not exist in any
# sigiled session and the repo's own gate had never once been run against it.
# The flag repeats per component: `--component rustfmt clippy` is rejected by
# rustup-init with "unexpected argument 'clippy' found", which failed the build
# and dropped that session onto the bare base image — no cargo at all. Cost a
# close+reopen to discover, because [workspace] is read from master and a
# dockerfile cannot be test-built from inside a session (rule 5, no docker).
FROM ghcr.io/ivan-saorin/vm-base:0.1.0

USER root
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
# The workspace /exec surface runs `bash -lc`: /etc/profile RESETS PATH and
# drops image ENV — learned live at the first open on this image (cargo
# installed, `which cargo` empty). /etc/profile.d is what login shells
# actually keep, so the toolchain env goes there too.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sSf https://sh.rustup.rs \
       | sh -s -- -y --no-modify-path --profile minimal --default-toolchain 1.97.1 \
              --component rustfmt --component clippy \
    && chmod -R a+rX /usr/local/rustup \
    && chmod -R a+w /usr/local/cargo \
    && printf 'export RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo\nexport PATH=/usr/local/cargo/bin:$PATH\n' \
       > /etc/profile.d/rust.sh
USER 1000:1000
